{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ES2020",
    "moduleResolution": "bundler",
    "jsx": "react",
    "lib": ["ES2020", "DOM"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "sourceMap": false,
    "removeComments": true,
    "allowSyntheticDefaultImports": true,
    "composite": true,
    "outDir": "../../../out/webview-tsbuild",
    "declaration": true
  },
  "include": ["./**/*"],
  "exclude": ["node_modules"]
}
