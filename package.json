{
  "name": "channel-config-manager",
  "displayName": "Channel Configuration Manager",
  "publisher": "rahma-bradai",
  "description": "Manage hardware and logical channel configurations, generate config.yaml, and validate with AI.",
  "version": "0.1.0",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished",
    "workspaceContains:**/MTF.yaml"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "channelConfig.openDashboard",
        "title": "Open Configuration Dashboard",
        "category": "Channel Config"
      },
      {
        "command": "channelConfig.manageLogicalChannels",
        "title": "Manage Logical Channels",
        "category": "Channel Config"
      },
      {
        "command": "channelConfig.manageHardwareChannels",
        "title": "Manage Hardware Channels",
        "category": "Channel Config"
      },
      {
        "command": "channelConfig.manageMappings",
        "title": "Manage Mappings",
        "category": "Channel Config"
      },
      {
        "command": "channelConfig.generateConfig",
        "title": "Generate config.yaml",
        "category": "Channel Config"
      },
      {
        "command": "channelConfig.importConfig",
        "title": "Import Configuration File",
        "category": "Channel Config"
      },
      {
        "command": "channelConfig.exportConfig",
        "title": "Export Configuration File",
        "category": "Channel Config"
      },
      {
        "command": "channelConfig.visualizeDiagram",
        "title": "Visualize Hardware Diagram",
        "category": "Channel Config"
      },
      {
        "command": "channelConfig.configureFramework",
        "title": "Configure Framework Parameters",
        "category": "Channel Config"
      },
      {
        "command": "channelConfig.runAIValidation",
        "title": "Analyze Configuration",
        "category": "Channel Config"
      },
      {
        "command": "channelConfig.connectUser",
        "title": "Channel Configuration: Connect User"
      },
      {
        "command": "channelConfig.disconnectUser",
        "title": "Channel Configuration: Disconnect User"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run bundle",
    "compile": "tsc -p ./ && webpack --config webpack.webview.config.js",
    "bundle": "tsc -p ./ --noEmit && webpack --config webpack.extension.config.js && webpack --config webpack.webview.config.js",
    "build:webview": "webpack --config webpack.webview.config.js",
    "regression:agent": "npm run compile && node scripts/run-agent-regressions.js",
    "watch": "tsc -watch -p ./",
    "watch:webview": "webpack --watch --config webpack.webview.config.js",
    "lint": "eslint src --ext ts"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/js-yaml": "^4.0.9",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^20.0.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/vscode": "^1.85.0",
    "@typescript-eslint/eslint-plugin": "^8.57.1",
    "@typescript-eslint/parser": "^8.57.1",
    "docx": "^9.6.1",
    "eslint": "^8.0.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "ts-loader": "^9.5.4",
    "typescript": "^5.3.0",
    "webpack": "^5.105.4",
    "webpack-cli": "^7.0.2"
  },
  "dependencies": {
    "ajv": "^8.18.0",
    "ajv-keywords": "^5.1.0",
    "bcryptjs": "^3.0.3",
    "js-yaml": "^4.1.0",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.20.0",
    "reflect-metadata": "^0.2.2",
    "typeorm": "^0.3.28"
  }
}
